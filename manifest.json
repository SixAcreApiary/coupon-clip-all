{
  "manifest_version": 3,
  "name": "Coupon Clip All",
  "version": "1.0.6",
  "description": "Unofficial helper that clips kroger.com digital coupons, skipping Boost Member Exclusive ones. Not affiliated with Kroger.",
  "homepage_url": "https://github.com/SixAcreApiary/coupon-clip-all",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.kroger.com/savings/cl/coupons*"
      ],
      "js": [
        "src/clipper.js",
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
